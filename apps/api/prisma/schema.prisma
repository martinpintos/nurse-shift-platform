// Core tables from docs/spec.md. Ids are plain strings so the seed can insert the spec's
// exact values (agency-a, nurse-1, shift-1). Agencies and users only come from the seed.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  nurse
  agency
  admin
}

enum ShiftRole {
  RN
  LPN
}

enum ShiftStatus {
  open
  filled
  cancelled
}

model Agency {
  id     String  @id
  name   String
  users  User[]
  shifts Shift[]
}

model User {
  id            String              @id
  name          String
  email         String              @unique
  passwordHash  String
  role          UserRole
  /// Set for agency logins: the agency this user acts for.
  agencyId      String?
  agency        Agency?             @relation(fields: [agencyId], references: [id])
  claimedShifts Shift[]
  credentials   Credential[]
  timesheets    Timesheet[]         @relation("TimesheetNurse")
  approvals     Timesheet[]         @relation("TimesheetApprover")
  lostClaims    ShiftCancellation[] @relation("CancellationPreviousNurse")
  cancellations ShiftCancellation[] @relation("CancellationActor")

  @@index([agencyId])
}

model Shift {
  /// Generated by the database ("shift-" || nextval) so concurrent posts can't collide.
  /// The seed moves shift_id_seq past the seeded shifts.
  id            String              @id @default(dbgenerated("('shift-'::text || nextval('shift_id_seq'::regclass))"))
  agencyId      String
  agency        Agency              @relation(fields: [agencyId], references: [id])
  role          ShiftRole
  /// Facility-local calendar date. Prisma returns it as a Date at UTC midnight.
  date          DateTime            @db.Date
  /// Facility-local 24-hour "HH:MM". endTime < startTime means an overnight shift.
  startTime     String              @db.VarChar(5)
  endTime       String              @db.VarChar(5)
  status        ShiftStatus         @default(open)
  claimedById   String?
  claimedBy     User?               @relation(fields: [claimedById], references: [id])
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  cancellations ShiftCancellation[]
  timesheets    Timesheet[]

  @@index([agencyId])
  @@index([claimedById])
}

enum CancelReason {
  no_show @map("no-show")
  advance
}

enum TimesheetStatus {
  submitted
  approved
}

/// A nurse's license document, stored in Postgres (bytea), MAX_CREDENTIAL_BYTES at most.
/// TB test results are never stored (ESCALATION.md).
model Credential {
  id          String   @id @default(uuid())
  nurseId     String
  nurse       User     @relation(fields: [nurseId], references: [id], onDelete: Cascade)
  /// Sanitized on upload, with the extension of the detected type.
  fileName    String   @db.VarChar(255)
  /// Detected from the file's magic bytes, never taken from the client.
  contentType String
  sizeBytes   Int
  data        Bytes
  /// Calendar date. Claims compare it with the shift date.
  expiresOn   DateTime @db.Date
  uploadedAt  DateTime @default(now())

  @@index([nurseId, expiresOn])
}

/// One cancelled claim. Cancelling reopens the shift; this keeps the history.
model ShiftCancellation {
  id              String       @id @default(uuid())
  shiftId         String
  shift           Shift        @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  reason          CancelReason
  previousNurseId String
  previousNurse   User         @relation("CancellationPreviousNurse", fields: [previousNurseId], references: [id], onDelete: Cascade)
  cancelledById   String
  cancelledBy     User         @relation("CancellationActor", fields: [cancelledById], references: [id], onDelete: Cascade)
  cancelledByRole UserRole
  cancelledAt     DateTime     @default(now())

  @@index([shiftId, cancelledAt])
}

/// Actual hours a nurse worked on her claimed shift. Minutes are derived (timesheetMinutes).
model Timesheet {
  id            String          @id @default(uuid())
  shiftId       String
  shift         Shift           @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  nurseId       String
  nurse         User            @relation("TimesheetNurse", fields: [nurseId], references: [id], onDelete: Cascade)
  /// Facility-local "HH:MM". An end before the start is an overnight shift.
  actualStart   String          @db.VarChar(5)
  actualEnd     String          @db.VarChar(5)
  minutesWorked Int
  status        TimesheetStatus @default(submitted)
  submittedAt   DateTime        @default(now())
  approvedAt    DateTime?
  approvedById  String?
  approvedBy    User?           @relation("TimesheetApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([shiftId, nurseId])
  @@index([nurseId])
}

/// Every state change, written in the same transaction as the change. `details` holds ids
/// and enum values only, never names, emails or file bytes.
model AuditLog {
  id         String   @id @default(uuid())
  /// Insertion order: a stable newest-first listing when timestamps tie.
  seq        Int      @unique @default(autoincrement())
  at         DateTime @default(now())
  actorId    String
  actorRole  UserRole
  /// An AuditAction from @repo/shared, e.g. "shift.claimed".
  action     String
  /// An AuditEntityType from @repo/shared.
  entityType String
  entityId   String?
  details    Json     @default("{}")
}

/// Demo outbox: the notifications that would have been emailed, stored instead of sent.
model OutboxMessage {
  id             String   @id @default(uuid())
  /// Insertion order: a stable newest-first listing when timestamps tie.
  seq            Int      @unique @default(autoincrement())
  createdAt      DateTime @default(now())
  /// An OutboxTemplate from @repo/shared, e.g. "shift.claimed".
  template       String
  shiftId        String
  recipientId    String
  recipientEmail String
  subject        String
  body           String
}
