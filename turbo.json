{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["API_URL"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "JWT_SECRET", "POSTHOG_KEY", "POSTHOG_HOST"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "env": [
        "API_URL",
        "DATABASE_URL",
        "PORT",
        "JWT_SECRET",
        "POSTHOG_KEY",
        "POSTHOG_HOST"
      ],
      "cache": false,
      "persistent": true
    }
  }
}
