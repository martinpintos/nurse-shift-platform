// Core tables from docs/spec.md. Ids are plain strings so the seed can insert the spec's
// exact values (agency-a, nurse-1, shift-1). Agencies and users only come from the seed.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  nurse
  agency
  admin
}

enum ShiftRole {
  RN
  LPN
}

enum ShiftStatus {
  open
  filled
  cancelled
}

model Agency {
  id     String  @id
  name   String
  users  User[]
  shifts Shift[]
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  passwordHash  String
  role          UserRole
  /// Set for agency logins: the agency this user acts for.
  agencyId      String?
  agency        Agency?  @relation(fields: [agencyId], references: [id])
  claimedShifts Shift[]

  @@index([agencyId])
}

model Shift {
  /// Generated by the database ("shift-" || nextval) so concurrent posts can't collide.
  /// The seed moves shift_id_seq past the seeded shifts.
  id          String      @id @default(dbgenerated("('shift-'::text || nextval('shift_id_seq'::regclass))"))
  agencyId    String
  agency      Agency      @relation(fields: [agencyId], references: [id])
  role        ShiftRole
  /// Facility-local calendar date. Prisma returns it as a Date at UTC midnight.
  date        DateTime    @db.Date
  /// Facility-local 24-hour "HH:MM". endTime < startTime means an overnight shift.
  startTime   String      @db.VarChar(5)
  endTime     String      @db.VarChar(5)
  status      ShiftStatus @default(open)
  claimedById String?
  claimedBy   User?       @relation(fields: [claimedById], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([agencyId])
  @@index([claimedById])
}
