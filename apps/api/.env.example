# Copy to .env and adjust. Never commit .env.
# Postgres connection string (local: `pnpm --filter api exec prisma dev`, or any Postgres 17).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shiftpatch"
# HTTP port for the API (the web app runs on 3000 and proxies /api/* here).
PORT=3001
# Signs login tokens (HS256). 32+ random bytes: `openssl rand -base64 48`. Never commit it.
JWT_SECRET="replace-with-output-of-openssl-rand-base64-48"
# PostHog (optional; analytics is off when unset). Server-side only, ids and event names.
POSTHOG_KEY=
POSTHOG_HOST="https://us.i.posthog.com"
