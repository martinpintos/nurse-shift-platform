{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "generate": {
      "inputs": ["prisma/**", "prisma.config.ts", "package.json"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["$TURBO_EXTENDS$", "generate"]
    },
    "check-types": {
      "dependsOn": ["$TURBO_EXTENDS$", "generate"]
    },
    "lint": {
      "dependsOn": ["$TURBO_EXTENDS$", "generate"]
    },
    "test": {
      "dependsOn": ["$TURBO_EXTENDS$", "generate"]
    },
    "dev": {
      "dependsOn": ["$TURBO_EXTENDS$", "generate"]
    }
  }
}
